<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kawapon.claude-remote-control</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Users/atsushikawasaki/.claude/scripts/rc-start.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/atsushikawasaki/dev/unsou-system</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/Users/atsushikawasaki/.claude/remote-control.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/atsushikawasaki/.claude/remote-control.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/atsushikawasaki/.local/bin:/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    <key>HOME</key>
    <string>/Users/atsushikawasaki</string>
  </dict>
</dict>
</plist>
